# Local development
PORT=7000
NODE_ENV=development

# L2 cache — Upstash Redis (REST API; works on BeamUp or any Node host)
# Create a free database at https://console.upstash.com/ and copy the REST
# credentials. Falls back silently to L1-only (in-memory) cache when unset.
# UPSTASH_REDIS_REST_URL=https://<db>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<token>

# Legacy alternative names, still accepted so existing deployments that set
# them don't silently drop to L1-only. Either pair works; prefer the ones above.
# REDIS_KV_REST_API_URL=
# REDIS_KV_REST_API_TOKEN=

# Manual cache invalidation route: GET /api/inv/<INV_KEY>?key=<cache-key>
# INV_KEY=

# Hot cache warming — Postgres (Neon recommended). The addon records every
# distinct upstream query plus its last payload, and a background loop replays
# the ones going stale on a fixed trickle, keeping L1 warm without user
# traffic and seeding it in bulk on a cold start. Unset → feature is off, the
# addon behaves exactly as without it. Prefer the pooled URL; the direct one
# is the fallback. The table is created automatically on first run.
# DATABASE_URL_POOLED=postgres://<user>:<pass>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
# DATABASE_URL=postgres://<user>:<pass>@<host>.<region>.aws.neon.tech/<db>?sslmode=require
# WARM_TICK_MS=4000          # ms between upstream replays (default 4000)
# WARM_RETENTION_DAYS=14     # stop replaying a query unrequested this long
# WARM_SEED_LIMIT=500        # max rows to seed into L1 on startup

# Set this on BeamUp only. BeamUp's nginx doesn't forward a Host header with
# the real public domain, so manifest.json's self-referencing "logo"/
# "background" URLs come out without a domain (unreachable) unless this is
# set explicitly. Not needed on hosts that forward a correct Host header.
# ADDON_PUBLIC_URL=https://5cfe2edf73d5-omnicatalogs.baby-beamup.club
